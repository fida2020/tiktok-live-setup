# Copy this file to .env and fill in real values. Never commit .env.

# --- OBS WebSocket ---
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# --- Paths ---
OBS_INSTALL_DIR=C:\Program Files\obs-studio
MEDIA_DIR=C:\TikTokLiveAutomation\media

# --- Controller ---
LOG_LEVEL=info
HEALTH_CHECK_INTERVAL_MS=15000
OBS_RECONNECT_INTERVAL_MS=5000
OBS_LAUNCH_TIMEOUT_MS=30000

# --- TikFinity event bridge (local webhook receiver) ---
# This starts a local HTTP server that TikFinity/Streamer.bot can be
# configured to call. It is NOT a TikTok/TikFinity login and requires
# no TikTok credentials.
TIKFINITY_BRIDGE_ENABLED=true
TIKFINITY_BRIDGE_HOST=127.0.0.1
TIKFINITY_BRIDGE_PORT=3939
# Shared secret the caller must send as `X-Bridge-Token` header.
TIKFINITY_BRIDGE_TOKEN=

# --- Local control dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4000

# Never put TikTok username/password or session cookies in this file.
# This automation never logs into TikTok and never starts a LIVE.
